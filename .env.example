# Local development keeps the existing JSON adapter.
AIDLINK_STORAGE_DRIVER=json
AIDLINK_DATA_PATH=server/data.json

# Production PostgreSQL example. Supply secrets through the deployment secret
# manager; never commit a real connection string.
DATABASE_URL=postgresql://aidlink_app:REPLACE_ME@127.0.0.1:5432/aidlink
AIDLINK_DB_SSL=false
AIDLINK_DB_SSL_REJECT_UNAUTHORIZED=true
AIDLINK_DB_POOL_MAX=10
AIDLINK_DB_CONNECT_TIMEOUT_MS=5000
AIDLINK_DB_IDLE_TIMEOUT_MS=30000
AIDLINK_DB_AUTO_MIGRATE=false
AIDLINK_DB_MIGRATION_VERIFIED=false
