{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "backend": "node --env-file-if-exists=.env server/server.js",
    "db:migrate": "node --env-file-if-exists=.env server/scripts/database.js migrate",
    "db:status": "node --env-file-if-exists=.env server/scripts/database.js status",
    "db:migrate:legacy": "node --env-file-if-exists=.env server/scripts/database.js import-legacy",
    "db:migrate:dry-run": "node --env-file-if-exists=.env server/scripts/database.js import-legacy --dry-run",
    "db:verify:legacy": "node --env-file-if-exists=.env server/scripts/database.js verify-legacy",
    "test": "node --test server/*.test.js",
    "test:postgres": "node --test server/postgres.integration.test.js",
    "test:web": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "clsx": "2.1.1",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "multer": "^2.2.0",
    "next-themes": "0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "recharts": "2.15.2",
    "sharp": "^0.35.3",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.1.12",
    "vite": "6.3.5",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  },
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a"
}
